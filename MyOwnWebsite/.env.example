# Public API base URL used by the ecommerce API demo.
VITE_API_BASE_URL=http://localhost:3000

# CSQAQ should be proxied by a backend in production. This value is only a
# development-time client configuration and must not be treated as a secret.
VITE_CSQAQ_API_BASE_URL=/api/csqaq
VITE_CSQAQ_API_TOKEN=

# Page Agent server settings. Keep the real key in .env.agent.local only.
AGENT_API_BASE_URL=https://your-openai-compatible-provider.example/v1
AGENT_API_KEY=
AGENT_MODEL=gpt-5.6-sol
AGENT_SERVER_HOST=127.0.0.1
AGENT_SERVER_PORT=8787
